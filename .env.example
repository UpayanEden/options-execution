# Options Execution System — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# ── Trading mode ────────────────────────────────────────────────────────────
# Default is PAPER — safe for all read-only and simulation operations.
TRADING_MODE=PAPER

# To enable live orders, BOTH of the following must be set exactly as shown:
# TRADING_MODE=LIVE
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_ORDERS_WILL_BE_PLACED

# ── Zerodha credentials ─────────────────────────────────────────────────────
# Obtain from https://kite.trade → My Apps
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here

# Access token expires daily. Run: python3 -m brokers.token_helper
# The helper writes it here automatically.
ZERODHA_ACCESS_TOKEN=

# ── Config paths ─────────────────────────────────────────────────────────────
STRATEGY_CONFIG=config/strategy.yaml
RISK_CONFIG=config/risk.yaml

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=logs/trading.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/execution.log
