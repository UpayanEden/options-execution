# ── Zerodha API Credentials ────────────────────────────────────────────────
# Copy this file to .env (or credentials.env) and fill in your real values.
# NEVER commit the real credentials file to version control.
# Add .env and credentials.env to .gitignore.
#
# How to obtain these values:
#   1. api_key and api_secret: https://kite.trade/docs/connect/v3/ → Create App
#   2. access_token: Generated fresh each trading day via the Kite login flow.
#      Use the token_helper.py script or the daily refresh cron job.

ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_ACCESS_TOKEN=your_access_token_here

# ── Trading mode ────────────────────────────────────────────────────────────
# Set to 'live' to enable real order placement.
# Default is 'paper' — paper mode never places real orders.
TRADING_MODE=paper

# ── Live order safety confirmation ─────────────────────────────────────────
# When TRADING_MODE=live, you must ALSO set this exact string.
# This double-confirmation prevents accidental live trading.
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_ORDERS_WILL_BE_PLACED

# ── Flask web app ───────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_secret_in_production

# ── Optional overrides ──────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_DIR=logs/live
# CONFIG_PATH=config/live_config.yaml
